---
import { Project } from "../scripts/models/project";
import ProjectImage from "./ProjectImage.astro";

interface Props {
	project: Project | any | null;
	large: boolean;
	cssClass: string;
}

const { project, large, cssClass } = Astro.props;
---

<div class={"center group relative transition-transform duration-300 ease-out hover:scale-105 hover:z-10 active:scale-105 active:z-10 " + cssClass}>
	{
		project.url ? (
			<a href={project.url} title={project.title} target="_blank" rel="noopener">
				<ProjectImage project={project} large={large} winner={project.isWinner} />
			</a>
		) : (
			<ProjectImage project={project} large={large} winner={project.isWinner} />
		)
	}
</div>
