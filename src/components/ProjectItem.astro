---
import { Project } from "../scripts/models/project";
import ProjectImage from "./ProjectImage.astro";

interface Props {
	project: Project | any | null;
	large: boolean;
	cssClass: string;
	index?: number;
}

const { project, large, cssClass, index = 0 } = Astro.props;
---

<div class={"group project-card " + cssClass}>
	{
		project.url ? (
			<a href={project.url} title={project.title} target="_blank" rel="noopener">
				<ProjectImage project={project} large={large} winner={project.isWinner} index={index} />
			</a>
		) : (
			<ProjectImage project={project} large={large} winner={project.isWinner} index={index} />
		)
	}
</div>
