---
import { Skill } from "../scripts/models/skill";

interface Props {
	skill: Skill | any | null;
}

const { skill } = Astro.props;

const style = [
	skill.background && `background-color: ${skill.background};`,
	skill.foreground && `color: ${skill.foreground};`,
]
	.filter(Boolean)
	.join(" ");
---

<div
	class={"dark:bg-black inline-flex items-center px-3 py-2 md:px-5 md:py-4 m-1 font-medium text-white rounded-md shadow-sm bg-ocean dark:text-mercury text-sm md:text-md relative transition-[transform,box-shadow,background-color,color] duration-100 ease-in-out hover:bg-tulip hover:text-black hover:scale-150 hover:shadow-lg hover:z-10 active:scale-150 active:shadow-xl active:z-10 cursor-pointer"}
	style={style}
>
	{
		skill.url ? (
			<a
				href={skill.url}
				target="_blank"
				rel="noopener"
				title={skill.title}
				class="hover:opacity-75"
				aria-label={skill.title}
			>
				{skill.title}
			</a>
		) : (
			<span title={skill.title} aria-label={skill.title}>
				{skill.title}
			</span>
		)
	}
</div>
