---
import { Skill } from "../scripts/models/skill";

interface Props {
	skill: Skill | any | null;
}

const { skill } = Astro.props;

const leftColStyle = [
	`background-color: ${skill.background || '#1f3245'};`,
	skill.foreground && `color: ${skill.foreground};`,
]
	.filter(Boolean)
	.join(" ");

const chipClasses = [
	"group relative inline-flex flex-row items-stretch text-center whitespace-nowrap max-w-full m-1 rounded-md overflow-hidden shadow-xs",
	"bg-elephant/70 dark:bg-black/80 border border-slate/40 text-sm cursor-pointer min-h-10.5 md:min-h-11.5 will-change-transform no-underline",
	"transition-[transform,box-shadow,background-color,border-color,color] duration-200 ease-[cubic-bezier(0.25,1,0.5,1)]",
	"hover:bg-elephant hover:border-slate/80 hover:text-white hover:z-30 hover:-translate-y-1 hover:scale-[1.22] hover:shadow-[0_16px_32px_-4px_rgba(0,0,0,0.55),0_6px_14px_-2px_rgba(0,0,0,0.35)] hover:duration-300 hover:ease-[cubic-bezier(0.34,1.56,0.64,1)]",
	"focus-visible:bg-elephant focus-visible:border-slate/80 focus-visible:text-white focus-visible:z-30 focus-visible:-translate-y-1 focus-visible:scale-[1.22] focus-visible:shadow-[0_16px_32px_-4px_rgba(0,0,0,0.55),0_6px_14px_-2px_rgba(0,0,0,0.35)] focus-visible:duration-300 focus-visible:ease-[cubic-bezier(0.34,1.56,0.64,1)]",
	"active:-translate-y-0.5 active:scale-[1.12] active:duration-100",
	"motion-reduce:transform-none motion-reduce:transition-none",
].join(" ");
---

{
	skill.url ? (
		<a
			href={skill.url}
			target="_blank"
			rel="noopener noreferrer"
			title={skill.title}
			class={chipClasses}
			aria-label={skill.title}
		>
			{skill.logo && (
				<span
					class="w-11 md:w-12 aspect-square flex items-center justify-center self-stretch shrink-0 p-2 md:p-2.5 transition-opacity duration-200 dark:opacity-75 group-hover:opacity-100 group-focus-visible:opacity-100"
					style={leftColStyle}
				>
					<img
						src={skill.logo}
						alt=""
						class="w-6 h-6 md:w-6.5 md:h-6.5 object-contain inline-block drop-shadow-xs"
						loading="lazy"
					/>
				</span>
			)}
			<span class="flex-1 min-w-max flex items-center justify-center px-4 py-2 text-center">
				<span class="whitespace-nowrap font-medium text-xs md:text-sm text-white dark:text-mercury">
					{skill.title}
				</span>
			</span>
		</a>
	) : (
		<div
			class={chipClasses}
			title={skill.title}
			aria-label={skill.title}
		>
			{skill.logo && (
				<span
					class="w-11 md:w-12 aspect-square flex items-center justify-center self-stretch shrink-0 p-2 md:p-2.5 transition-opacity duration-200 dark:opacity-75 group-hover:opacity-100 group-focus-visible:opacity-100"
					style={leftColStyle}
				>
					<img
						src={skill.logo}
						alt=""
						class="w-6 h-6 md:w-6.5 md:h-6.5 object-contain inline-block drop-shadow-xs"
						loading="lazy"
					/>
				</span>
			)}
			<span class="flex-1 min-w-max flex items-center justify-center px-4 py-2 text-center">
				<span class="whitespace-nowrap font-medium text-xs md:text-sm text-white dark:text-mercury">
					{skill.title}
				</span>
			</span>
		</div>
	)
}
