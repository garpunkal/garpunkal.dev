---
interface Props {
	anchor: string;
}

const { anchor } = Astro.props;
---

<a href={"#" + anchor} title={`Scroll to ${anchor}`} aria-label={`Scroll to ${anchor}`} id="downArrow">
	<svg
		class="w-6 h-6 animate-bounce text-white dark:text-iron"
		fill="none"
		stroke-linecap="round"
		stroke-linejoin="round"
		stroke-width="2"
		viewBox="0 0 24 24"
		stroke="currentColor"
		width="24px"
		height="100%"
		aria-hidden="true"
	>
		<path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
	</svg>
</a>
