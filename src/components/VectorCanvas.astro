---
// VectorCanvas.astro
// Silky-smooth flowing vector wave contours / topographic ribbons undulating across the dark mirage background
---

<canvas
	id="mirage-vectors-canvas"
	class="pointer-events-none fixed inset-0 w-full h-full z-0 block opacity-95 transition-opacity duration-500"
	aria-hidden="true"
></canvas>

<script>
	interface WaveRibbon {
		baseYRatio: number; // 0 to 1 position down the canvas
		amplitude: number;
		speed: number;
		frequency: number;
		harmonicAmp: number;
		harmonicFreq: number;
		phase: number;
		lineWidth: number;
		colorStart: string;
		colorMid: string;
		colorEnd: string;
		alpha: number;
		hasFill: boolean;
	}

	function initWaveCanvas() {
		const canvas = document.getElementById("mirage-vectors-canvas") as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext("2d", { alpha: true });
		if (!ctx) return;

		const mainEl = document.getElementById("main") || canvas.parentElement;

		let width = 0;
		let height = 0;
		let dpr = 1;
		let animationFrameId: number | null = null;
		let isVisible = true;
		let isRunning = false;

		// Mouse disturbance tracking
		const mouse = {
			x: -9999,
			y: -9999,
			active: false,
			radius: 220,
		};

		// Wave ribbon definitions
		let ribbons: WaveRibbon[] = [];

		function initRibbons() {
			ribbons = [
				// Top cluster: ocean to slate
				{
					baseYRatio: 0.18,
					amplitude: 38,
					speed: 0.00045,
					frequency: 0.0018,
					harmonicAmp: 18,
					harmonicFreq: 0.0042,
					phase: 0.2,
					lineWidth: 1.2,
					colorStart: "rgba(7, 125, 160, 0.25)",
					colorMid: "rgba(156, 163, 175, 0.15)",
					colorEnd: "rgba(7, 125, 160, 0.22)",
					alpha: 0.22,
					hasFill: true,
				},
				{
					baseYRatio: 0.24,
					amplitude: 45,
					speed: 0.00038,
					frequency: 0.0015,
					harmonicAmp: 22,
					harmonicFreq: 0.0035,
					phase: 1.1,
					lineWidth: 1,
					colorStart: "rgba(156, 163, 175, 0.18)",
					colorMid: "rgba(7, 125, 160, 0.22)",
					colorEnd: "rgba(227, 180, 64, 0.16)",
					alpha: 0.18,
					hasFill: false,
				},
				{
					baseYRatio: 0.31,
					amplitude: 32,
					speed: 0.00052,
					frequency: 0.0022,
					harmonicAmp: 14,
					harmonicFreq: 0.0048,
					phase: 2.3,
					lineWidth: 0.9,
					colorStart: "rgba(7, 125, 160, 0.16)",
					colorMid: "rgba(209, 213, 219, 0.12)",
					colorEnd: "rgba(7, 125, 160, 0.14)",
					alpha: 0.15,
					hasFill: false,
				},

				// Mid cluster: fluid ocean & gold accents
				{
					baseYRatio: 0.48,
					amplitude: 52,
					speed: 0.00035,
					frequency: 0.0012,
					harmonicAmp: 26,
					harmonicFreq: 0.0028,
					phase: 3.5,
					lineWidth: 1.4,
					colorStart: "rgba(7, 125, 160, 0.28)",
					colorMid: "rgba(227, 180, 64, 0.22)",
					colorEnd: "rgba(7, 125, 160, 0.24)",
					alpha: 0.25,
					hasFill: true,
				},
				{
					baseYRatio: 0.54,
					amplitude: 42,
					speed: 0.00042,
					frequency: 0.0016,
					harmonicAmp: 20,
					harmonicFreq: 0.0038,
					phase: 4.2,
					lineWidth: 1,
					colorStart: "rgba(227, 180, 64, 0.18)",
					colorMid: "rgba(7, 125, 160, 0.22)",
					colorEnd: "rgba(156, 163, 175, 0.16)",
					alpha: 0.18,
					hasFill: false,
				},
				{
					baseYRatio: 0.60,
					amplitude: 36,
					speed: 0.00048,
					frequency: 0.0019,
					harmonicAmp: 16,
					harmonicFreq: 0.0045,
					phase: 5.1,
					lineWidth: 0.9,
					colorStart: "rgba(7, 125, 160, 0.15)",
					colorMid: "rgba(156, 163, 175, 0.12)",
					colorEnd: "rgba(7, 125, 160, 0.14)",
					alpha: 0.14,
					hasFill: false,
				},

				// Lower cluster: deep calming ocean contours
				{
					baseYRatio: 0.75,
					amplitude: 48,
					speed: 0.00032,
					frequency: 0.0013,
					harmonicAmp: 24,
					harmonicFreq: 0.0031,
					phase: 1.8,
					lineWidth: 1.3,
					colorStart: "rgba(7, 125, 160, 0.24)",
					colorMid: "rgba(156, 163, 175, 0.16)",
					colorEnd: "rgba(7, 125, 160, 0.2)",
					alpha: 0.2,
					hasFill: true,
				},
				{
					baseYRatio: 0.82,
					amplitude: 38,
					speed: 0.00040,
					frequency: 0.0017,
					harmonicAmp: 18,
					harmonicFreq: 0.0040,
					phase: 2.7,
					lineWidth: 1,
					colorStart: "rgba(156, 163, 175, 0.16)",
					colorMid: "rgba(7, 125, 160, 0.2)",
					colorEnd: "rgba(209, 213, 219, 0.14)",
					alpha: 0.16,
					hasFill: false,
				},
				{
					baseYRatio: 0.89,
					amplitude: 30,
					speed: 0.00046,
					frequency: 0.0021,
					harmonicAmp: 12,
					harmonicFreq: 0.0049,
					phase: 3.9,
					lineWidth: 0.85,
					colorStart: "rgba(7, 125, 160, 0.14)",
					colorMid: "rgba(227, 180, 64, 0.12)",
					colorEnd: "rgba(7, 125, 160, 0.12)",
					alpha: 0.12,
					hasFill: false,
				},
			];
		}

		function resize() {
			if (!canvas || !ctx) return;
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;

			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			initRibbons();
		}

		function getWaveY(x: number, r: WaveRibbon, time: number): number {
			const baseY = r.baseYRatio * height;

			// Primary wave
			const w1 = Math.sin(x * r.frequency + time * r.speed + r.phase) * r.amplitude;
			// Secondary harmonic
			const w2 = Math.cos(x * r.harmonicFreq - time * (r.speed * 0.75) + r.phase * 1.5) * r.harmonicAmp;
			// Tertiary subtle ripple
			const w3 = Math.sin(x * 0.008 + time * 0.0006) * 4;

			let y = baseY + w1 + w2 + w3;

			// Interactive mouse displacement (soft Gaussian ripple)
			if (mouse.active) {
				const dx = x - mouse.x;
				const dy = y - mouse.y;
				const distSq = dx * dx + dy * dy;
				const radiusSq = mouse.radius * mouse.radius;

				if (distSq < radiusSq) {
					const dist = Math.sqrt(distSq);
					// Gentle push/lift effect around cursor
					const factor = Math.cos((dist / mouse.radius) * (Math.PI / 2));
					const displacement = factor * (dy > 0 ? 28 : -28);
					y += displacement;
				}
			}

			return y;
		}

		function draw(time: number) {
			if (!ctx) return;
			ctx.clearRect(0, 0, width, height);

			const step = Math.max(6, Math.floor(width / 140));

			for (let i = 0; i < ribbons.length; i++) {
				const r = ribbons[i];

				// Compute path points
				const points: { x: number; y: number }[] = [];
				for (let x = -20; x <= width + 20; x += step) {
					points.push({ x, y: getWaveY(x, r, time) });
				}

				// Create dynamic horizontal gradient for this ribbon
				const grad = ctx.createLinearGradient(0, 0, width, 0);
				grad.addColorStop(0, r.colorStart);
				grad.addColorStop(0.5, r.colorMid);
				grad.addColorStop(1, r.colorEnd);

				// Optional faint translucent under-fill to give topographic depth
				if (r.hasFill) {
					ctx.save();
					ctx.beginPath();
					ctx.moveTo(points[0].x, points[0].y);
					for (let p = 1; p < points.length; p++) {
						ctx.lineTo(points[p].x, points[p].y);
					}
					ctx.lineTo(width + 20, points[points.length - 1].y + 40);
					ctx.lineTo(-20, points[0].y + 40);
					ctx.closePath();

					const fillGrad = ctx.createLinearGradient(0, points[0].y, 0, points[0].y + 40);
					fillGrad.addColorStop(0, "rgba(7, 125, 160, 0.022)");
					fillGrad.addColorStop(1, "rgba(7, 125, 160, 0)");
					ctx.fillStyle = fillGrad;
					ctx.fill();
					ctx.restore();
				}

				// Draw the silky wave stroke
				ctx.save();
				ctx.strokeStyle = grad;
				ctx.lineWidth = r.lineWidth;
				ctx.lineCap = "round";
				ctx.lineJoin = "round";

				ctx.beginPath();
				ctx.moveTo(points[0].x, points[0].y);

				// Smooth quadratic curve interpolation through points
				for (let p = 1; p < points.length - 1; p++) {
					const xc = (points[p].x + points[p + 1].x) / 2;
					const yc = (points[p].y + points[p + 1].y) / 2;
					ctx.quadraticCurveTo(points[p].x, points[p].y, xc, yc);
				}
				ctx.lineTo(points[points.length - 1].x, points[points.length - 1].y);
				ctx.stroke();
				ctx.restore();
			}

			// Subtle mouse glow highlight when over mirage area
			if (mouse.active) {
				const mouseGlow = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, mouse.radius * 0.85);
				mouseGlow.addColorStop(0, "rgba(7, 125, 160, 0.05)");
				mouseGlow.addColorStop(0.6, "rgba(7, 125, 160, 0.015)");
				mouseGlow.addColorStop(1, "rgba(7, 125, 160, 0)");
				ctx.fillStyle = mouseGlow;
				ctx.beginPath();
				ctx.arc(mouse.x, mouse.y, mouse.radius * 0.85, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function loop(time: number) {
			if (!isRunning) return;
			draw(time);
			animationFrameId = requestAnimationFrame(loop);
		}

		function start() {
			if (!isRunning) {
				isRunning = true;
				animationFrameId = requestAnimationFrame(loop);
			}
		}

		function stop() {
			isRunning = false;
			if (animationFrameId !== null) {
				cancelAnimationFrame(animationFrameId);
				animationFrameId = null;
			}
		}

		// Reduced motion check
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (prefersReducedMotion) {
			resize();
			draw(1000);
			return;
		}

		// Mouse tracking
		const onPointerMove = (e: MouseEvent) => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
			mouse.active = true;
		};

		const onPointerLeave = () => {
			mouse.active = false;
		};

		window.addEventListener("pointermove", onPointerMove, { passive: true });
		document.body.addEventListener("pointerleave", onPointerLeave, { passive: true });

		// Resize listener with debounced re-init
		let resizeTimer: number | undefined;
		const onResize = () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(resize, 100);
		};
		window.addEventListener("resize", onResize, { passive: true });

		// Intersection observer: only animate and show when main is in viewport
		if (mainEl && "IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					const entry = entries[0];
					isVisible = entry.isIntersecting;
					if (isVisible && document.visibilityState === "visible") {
						canvas.style.opacity = "0.95";
						start();
					} else {
						canvas.style.opacity = "0";
						stop();
					}
				},
				{ threshold: 0.02 }
			);
			observer.observe(mainEl);
		} else {
			start();
		}

		// Visibility change listener
		const onVisibilityChange = () => {
			if (document.visibilityState === "visible" && isVisible) {
				start();
			} else {
				stop();
			}
		};
		document.addEventListener("visibilitychange", onVisibilityChange);

		resize();
		start();
	}

	if (typeof window !== "undefined") {
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initWaveCanvas);
		} else {
			initWaveCanvas();
		}
	}
</script>
