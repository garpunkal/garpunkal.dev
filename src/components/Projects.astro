---

import { Project } from "../scripts/models/project";
import ProjectItem from "./ProjectItem.astro";
import Heading from "./Heading.astro";

interface Props {

	projects: Project[] | any | null;
	title: string | any | null;
	personal?: boolean;
}

const { projects, title, personal = false } = Astro.props;

const sortedProjects = projects
	.filter((p: Project) => personal || p.isHighlight || p.isWinner)
	.sort((n1: Project, n2: Project) => (n1.sortOrder > n2.sortOrder ? 1 : n1.sortOrder < n2.sortOrder ? -1 : 0))
	.reverse();

const largeProjects = sortedProjects.slice(0, personal ? 4 : 6);
const smallProjects = sortedProjects.slice(personal ? 4 : 6, sortedProjects.length).sort((a: Project, b: Project) => a.title.localeCompare(b.title));
---


<section class="text-pale bg-mirage dark:text-iron0 body-font" id="projects">
	<div class="container">
		<Heading title={title}/>
		<div class="flex flex-wrap -m-1 md:-m-2 mb-2 md:mb-2">
			{
				largeProjects
					.map((project: Project) => (
						<ProjectItem
							project={project}
							large={true}
							cssClass="flex flex-wrap w-full lg:flex-grow md:w-1/2 lg:w-1/2 p-2"
							personal={personal}
						/>
					))
			}
		</div>
			<div class="flex flex-wrap -m-1 md:-m-2 justify-center">
			{
				smallProjects
					.map((project: Project) => (
						<ProjectItem project={project} large={false} cssClass="flex flex-wrap w-1/2 md:w-1/3 lg:w-1/4 p-2" personal={personal} />
					))
			}
		</div>
	</div>
</section>