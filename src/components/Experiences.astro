---
import ExperienceItem from "./ExperienceItem.astro";
import Heading from "./Heading.astro";
import { Experience } from "../scripts/models/experience";
import { Home } from "../scripts/models/home";

interface Props {
	home: Home | any | null;
	experiences: Experience[] | any | null;
}

const { home, experiences } = Astro.props;

const sortedExperiences = experiences
	.sort((n1: Experience, n2: Experience) => (n1.orderDate && n2.orderDate ? (n1.orderDate > n2.orderDate ? 1 : n1.orderDate < n2.orderDate ? -1 : 0) : 0))
	.reverse();
---
<section class="bg-transparent body-font" id="experiences">
	<div class="container">
		<Heading title={home?.experiencesLabel}/>
		
		<ol class="relative mx-auto w-full list-none px-0 pb-0 pt-4 max-md:pl-6" data-experience-timeline>
			<span
				class="pointer-events-none absolute left-1/2 z-0 w-[3px] -translate-x-[1.5px] bg-gradient-to-b from-ocean via-ocean/70 to-slate/50 shadow-[0_0_12px_rgba(7,125,160,0.5)] max-md:left-0 max-md:translate-x-0"
				data-experience-rail
				aria-hidden="true"
			/>
			{
				sortedExperiences.map((experience: Experience, index: number) => (
					<li
						class:list={[
							"group/item relative z-[1] box-border w-1/2 pb-0 pr-[3.75rem]",
							"after:absolute after:right-[-12px] after:top-[1.15rem] after:size-6 after:rounded-full after:border-4 after:border-mirage after:bg-[var(--timeline-marker)] after:transition-all after:duration-300 after:ease-[cubic-bezier(0.34,1.56,0.64,1)]",
							"before:absolute before:right-0 before:top-[1.85rem] before:h-[2px] before:w-[3.75rem] before:bg-[var(--timeline-marker)] before:transition-all before:duration-200",
							"group-hover/item:after:scale-[1.4] group-hover/item:after:border-mirage group-hover/item:after:shadow-[0_0_0_3px_var(--timeline-marker),0_0_20px_var(--timeline-marker),0_0_36px_var(--timeline-marker)]",
							"group-hover/item:before:h-[3px] group-hover/item:before:shadow-[0_0_12px_var(--timeline-marker)]",
							"group-focus-within/item:after:scale-[1.4] group-focus-within/item:after:border-mirage group-focus-within/item:after:shadow-[0_0_0_3px_var(--timeline-marker),0_0_20px_var(--timeline-marker),0_0_36px_var(--timeline-marker)]",
							"group-focus-within/item:before:h-[3px] group-focus-within/item:before:shadow-[0_0_12px_var(--timeline-marker)]",
							experience.isCurrent && "after:animate-marker-glow motion-reduce:after:animate-none",
							"max-md:w-full max-md:pb-4 max-md:pl-7 max-md:pr-0 max-md:after:left-[calc(-1.5rem-12px)] max-md:after:right-auto max-md:before:left-[-1.5rem] max-md:before:right-auto max-md:before:w-[3.25rem]",
							index % 2 === 1 && "md:ml-[50%] md:max-lg:mt-[-15rem] lg:mt-[-8rem] md:pl-[3.75rem] md:pr-0 md:after:left-[-12px] md:after:right-auto md:before:left-0 md:before:right-auto"
						]}
						style={"--timeline-marker:" + experience.logo.background}
					>
						<ExperienceItem experience={experience} />
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	const timelines = document.querySelectorAll<HTMLOListElement>("[data-experience-timeline]");

	const positionRail = (timeline: HTMLOListElement) => {
		const rail = timeline.querySelector<HTMLElement>("[data-experience-rail]");
		const entries = timeline.querySelectorAll<HTMLElement>(":scope > li");

		if (!rail || entries.length === 0) return;

		const timelineTop = timeline.getBoundingClientRect().top;
		const markerCenter = (entry: HTMLElement) => {
			const entryStyles = getComputedStyle(entry, "::after");
			const entryTop = entry.getBoundingClientRect().top - timelineTop;
			return entryTop + parseFloat(entryStyles.top) + parseFloat(entryStyles.height) / 2;
		};
		const top = markerCenter(entries[0]);
		const bottom = markerCenter(entries[entries.length - 1]);

		rail.style.top = `${top}px`;
		rail.style.height = `${Math.max(0, bottom - top)}px`;
	};

	for (const timeline of timelines) {
		const update = () => requestAnimationFrame(() => positionRail(timeline));
		update();
		new ResizeObserver(update).observe(timeline);
		window.addEventListener("resize", update);
	}
</script>
