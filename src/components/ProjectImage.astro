---
import { Image } from "astro:assets";
import { Project } from "../scripts/models/project";
interface Props {
	project: Project | any | null;
	large: boolean;
	winner: boolean;
	personal?: boolean;
}

const { project, large, winner, personal = false } = Astro.props;

const dripColorClass = winner
	? "bg-tulip dark:bg-mirage"
	: personal
		? "bg-slate dark:bg-mirage"
		: "bg-ocean dark:bg-mirage";

// Map a position string to its Tailwind object-position class and the sharp `position` value.
// To add a new position, add a single entry here.
const positionMap: Record<string, { cls: string; pos: string }> = {
	"left top":      { cls: "object-top-left",    pos: "left top" },
	"center top":    { cls: "object-top",          pos: "top" },
	"right top":     { cls: "object-top-right",   pos: "right top" },
	"left middle":   { cls: "object-left",         pos: "left" },
	"center middle": { cls: "object-center",       pos: "center" },
	"right middle":  { cls: "object-right",        pos: "right" },
	"left bottom":   { cls: "object-bottom-left",  pos: "left bottom" },
	"center bottom": { cls: "object-bottom",       pos: "bottom" },
	"right bottom":  { cls: "object-bottom-right", pos: "right bottom" },
	"center":        { cls: "object-center",       pos: "center" },
};

const { cls: positionClass, pos: sharpPosition } =
	positionMap[project.position ?? ""] ?? { cls: "object-top", pos: "top" };
---

<figure class="relative w-full aspect-video overflow-hidden rounded-lg">
	{
		project.image?.url ? (
			<Image
				src={project.image.url}
				format="webp"
				quality={68}
				widths={large ? [380, 540, 608, 720] : [184, 240, 296, 360]}
				sizes={
					large
						? "(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) calc(50vw - 32px), (max-width: 1279px) 480px, 608px"
						: "(max-width: 767px) calc(50vw - 24px), (max-width: 1023px) calc(33vw - 24px), (max-width: 1279px) 232px, 296px"
				}
				alt={"screenshot of " + project.image.alt}
				class={`block w-full h-full ${positionClass} object-cover dark:brightness-75 dark:hover:brightness-100 rounded-lg aspect-video`}
				loading="lazy"
				title={project.title}
				width={large ? 608 : 296}
				height={large ? 342 : 166}
				fit="cover"
				position={sharpPosition}
			/>
		) : (
			<div class="w-full aspect-video rounded-lg bg-slate/30 flex items-center justify-center">
				<span class="text-xs text-pale/50">No image</span>
			</div>
		)
	}

	{
		winner ? (
			<figcaption class="absolute px-2 py-1 text-black left-0 bottom-0 md:px-4 md:py-2 bg-tulip dark:bg-mirage rounded-bl-lg rounded-tr-lg text-sm md:text-base hover:text-black dark:text-cool shadow-[0_4px_6px_rgba(0,0,0,0.5)]">
				{project.title}
			</figcaption>
		) : (
			<figcaption class={`absolute px-2 py-1 text-white left-0 bottom-0 md:px-4 md:py-2 ${personal ? 'bg-slate text-white' : 'bg-ocean text-white'} dark:bg-mirage dark:text-cool rounded-bl-lg rounded-tr-lg text-sm md:text-base shadow-[0_4px_6px_rgba(0,0,0,0.5)]`}>
				{project.title}
			</figcaption>
		)
	}

	<div
		class="absolute inset-0 overflow-hidden rounded-lg pointer-events-none flex"
		data-drip-container
		data-drip-color={dripColorClass}
	></div>

	<div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 pointer-events-none overflow-hidden">
		<span
			class:list={[
				"font-bold text-sm md:text-lg w-full line-clamp-2 opacity-0 scale-90 transition-all duration-200 ease-out delay-[150ms] group-hover:opacity-100 group-hover:scale-100",
				winner ? "text-black dark:text-cool" : "text-white dark:text-cool",
			]}
		>
			{project.title}
		</span>
		{
			winner && (
				<>
					<span class="text-xs md:text-base w-full line-clamp-2 text-black dark:text-cool opacity-0 scale-90 transition-all duration-200 ease-out delay-[190ms] group-hover:opacity-100 group-hover:scale-100">
						{project.winnerLabel}
					</span>
					<span class="text-xs md:text-base w-full line-clamp-2 text-black dark:text-cool opacity-0 scale-90 transition-all duration-200 ease-out delay-[230ms] group-hover:opacity-100 group-hover:scale-100">
						{project.winnerDescription}
					</span>
				</>
			)
		}
	</div>
</figure>
