---
import { Picture } from "astro:assets";
import { Project } from "../scripts/models/project";
interface Props {
	project: Project | any | null;
	large: boolean;
	winner: boolean;
	personal?: boolean;
}

const { project, large, winner, personal = false } = Astro.props;

// vertical drips that grow in from the top or bottom edge on hover, with random widths and stagger so they trickle in like dripping/rising paint before filling the panel
const dripCount = 40;
const drips = Array.from({ length: dripCount }, () => {
	const delay = Math.random() * 150;
	const duration = 200 + Math.random() * 120;
	const grow = 0.4 + Math.random() * 1.8;
	const fromBottom = Math.random() < 0.5;
	return { delay, duration, grow, fromBottom };
});
---

<figure class="relative w-full h-full overflow-hidden rounded-lg">
	{
		project.position === "left top" ? (
			<Picture
				src={project.image.url}
				formats={["webp"]}
				widths={[300, 540, 616, 720, 990]}
				sizes={`(max-width: 360px) 300px, (max-width: 720px) 540px, (max-width: 1024px) 720px, 990px`}
				alt={"screenshot of " + project.image.alt}
				class="block w-full h-full object-left-top object-cover dark:brightness-75 dark:hover:brightness-100 rounded-lg aspect-video"
				loading="lazy"
				title={project.title}
				width={large ? 616 : 300}
				height={large ? 328 : 168}
				fit="cover"
				position="left top"
			/>
		) : (
			<Picture
				src={project.image.url}
				formats={["webp"]}
				widths={[300, 540, 616, 720, 990]}
				sizes={`(max-width: 360px) 300px, (max-width: 720px) 540px, (max-width: 1024px) 720px, 990px`}
				alt={"screenshot of " + project.image.alt}
				class="block w-full h-full object-top object-cover dark:brightness-75 dark:hover:brightness-100 rounded-lg aspect-video "
				loading="lazy"
				title={project.title}
				width={large ? 616 : 300}
				height={large ? 328 : 168}
				fit="cover"
				position="top"
			/>
		)
	}

	{
		winner ? (
			<figcaption class="absolute px-2 py-1 text-black left-0 bottom-0 md:px-4 md:py-2 bg-tulip dark:bg-mirage rounded-bl-lg rounded-tr-lg text-sm md:text-base hover:text-black dark:text-cool shadow-[0_4px_6px_rgba(0,0,0,0.5)]">
				{project.title}
			</figcaption>
		) : (
			<figcaption class={`absolute px-2 py-1 text-white left-0 bottom-0 md:px-4 md:py-2 ${personal ? 'bg-slate text-white' : 'bg-ocean text-white'} dark:bg-mirage dark:text-cool rounded-bl-lg rounded-tr-lg text-sm md:text-base shadow-[0_4px_6px_rgba(0,0,0,0.5)]`}>
				{project.title}
			</figcaption>
		)
	}

	<div class="absolute inset-0 overflow-hidden rounded-lg pointer-events-none flex">
		{
			drips.map((drip) => (
				<div
					class:list={[
						// drip utility handles scale, transition timing/duration/delay, and group-hover reveal
						"drip",
						drip.fromBottom ? "origin-bottom" : "origin-top",
						winner ? "bg-tulip dark:bg-mirage" : personal ? "bg-slate dark:bg-mirage" : "bg-ocean dark:bg-mirage",
					]}
					style={`flex-grow:${drip.grow}; flex-basis:0%; --dur:${drip.duration}ms; --del:${drip.delay}ms;`}
				/>
			))
		}
	</div>

	<div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 pointer-events-none overflow-hidden">
		<span
			class:list={[
				// fade-in-scale handles opacity/scale reveal; --reveal-delay staggers per element
				"font-bold text-sm md:text-lg w-full line-clamp-2 fade-in-scale [--reveal-delay:150ms]",
				winner ? "text-black dark:text-cool" : "text-white dark:text-cool",
			]}
		>
			{project.title}
		</span>
		{
			winner && (
				<>
					<span class="text-xs md:text-base w-full line-clamp-2 text-black dark:text-cool fade-in-scale [--reveal-delay:190ms]">
						{project.winnerLabel}
					</span>
					<span class="text-xs md:text-base w-full line-clamp-2 text-black dark:text-cool fade-in-scale [--reveal-delay:230ms]">
						{project.winnerDescription}
					</span>
				</>
			)
		}
	</div>
</figure>
