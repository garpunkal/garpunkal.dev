---
import { Picture } from "astro:assets";
import { Article } from "../scripts/models/article";
import Tag from "./Tag.astro";
interface Props {
	article: Article | any | null;
	cssClass: string;
}

const { article, cssClass } = Astro.props;

const dripCount = 40;
const drips = Array.from({ length: dripCount }, () => {
	const delay = Math.random() * 150;
	const duration = 200 + Math.random() * 120;
	const grow = 0.4 + Math.random() * 1.8;
	const fromBottom = Math.random() < 0.5;
	return { delay, duration, grow, fromBottom };
});
---

<div class={cssClass}>
	<div class="flex-1">
		<a href={article.canonical_url} target="_blank" rel="noopener" title={article.title}>
			<figure class="group relative overflow-hidden rounded-t-lg" role="none">
				<Picture
					src={article.cover_image}
					formats={["webp"]}
					widths={[240, 320, 404]}
					sizes={`(max-width: 360px) 240px, (max-width: 720px) 320px, 404px`}


					alt={"screenshot of " + article.title}
					class="rounded-t-lg dark:brightness-75 dark:hover:brightness-100"
					loading="lazy"
					title={article.title}
					width="404"
					height="170"
				/>
				<div class="absolute inset-0 overflow-hidden rounded-t-lg pointer-events-none flex">
					{
						drips.map((drip) => (
							<div
								class:list={[
									"drip",
									drip.fromBottom ? "origin-bottom" : "origin-top",
									"bg-ocean dark:bg-mirage",
								]}
								style={`flex-grow:${drip.grow}; flex-basis:0%; --dur:${drip.duration}ms; --del:${drip.delay}ms;`}
							/>
						))
					}
				</div>
				<div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 pointer-events-none overflow-hidden">
					<span
						class:list={[
							"font-bold text-sm md:text-lg w-full line-clamp-2 fade-in-scale [--reveal-delay:150ms]",
							"text-white dark:text-cool",
						]}
					>
						{article.title}
					</span>
				</div>
			</figure>
			<div class="px-6 pt-6">
				<h2 class="mb-3 text-lg font-bold text-white dark:text-cool min-h-[56px]">
					{article.title}
				</h2>
				<p class="mb-3 leading-relaxed text-iron dark:text-cool">
					{article.description}
				</p>
			</div>
		</a>
		<div class="p-6">
			{article.tag_list.map((tag: string) => <Tag tag={tag} />)}
		</div>
	</div>
</div>
