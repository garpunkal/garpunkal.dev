---
// ProjectLightbox.astro - Full-screen modal overlay for enlarged project pictures and details with touch/swipe support
---

<dialog
	id="project-lightbox"
	class="fixed inset-0 m-auto p-3 sm:p-6 md:p-8 w-full max-w-5xl max-h-[94vh] bg-transparent border-0 z-50 overflow-hidden outline-none"
	aria-labelledby="lightbox-title"
	aria-modal="true"
>
	<div
		id="lightbox-card"
		class="relative flex flex-col w-full h-full max-h-[90vh] bg-ocean dark:bg-black border-2 border-white/35 dark:border-cool/50 text-white dark:text-iron rounded-2xl shadow-2xl dark:shadow-[0_0_0_1px_rgba(255,255,255,0.18),0_25px_50px_-12px_rgba(0,0,0,0.95)] overflow-hidden backdrop-blur-md"
	>
		<!-- Header -->
		<header class="flex items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4 border-b border-white/20 dark:border-slate/60 bg-ocean/80 dark:bg-mirage/30">
			<div class="flex flex-col min-w-0 pr-2">
				<div class="flex items-center gap-2 mb-1 flex-wrap">
					<span
						id="lightbox-badge-winner"
						class="hidden px-2.5 py-0.5 text-xs font-bold rounded-full bg-tulip text-black items-center gap-1 shadow-sm"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
						</svg>
						<span id="lightbox-winner-label">Award Winner</span>
					</span>
					<span
						id="lightbox-badge-personal"
						class="hidden px-2 py-0.5 text-xs font-semibold rounded-full bg-white/20 text-white border border-white/30 dark:bg-slate/60 dark:text-iron dark:border-slate/40"
					>
						Personal Project
					</span>
					<span id="lightbox-counter" class="text-xs text-white/80 dark:text-cool/80 font-mono"></span>
				</div>
				<h2 id="lightbox-title" class="text-lg sm:text-2xl font-extrabold text-white tracking-tight truncate"></h2>
			</div>

			<button
				id="lightbox-close"
				type="button"
				class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 text-white dark:bg-slate/30 dark:hover:bg-slate/70 dark:text-iron transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-white cursor-pointer"
				aria-label="Close project preview"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</header>

		<!-- Stage / Image Area with touch support -->
		<div
			id="lightbox-stage"
			class="relative flex-1 min-h-[240px] sm:min-h-[320px] max-h-[62vh] bg-black/60 flex items-center justify-center p-2 sm:p-4 overflow-hidden select-none touch-pan-y"
		>
			<!-- Prev Button -->
			<button
				id="lightbox-prev"
				type="button"
				class="absolute left-2 sm:left-4 z-10 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-white hover:text-ocean text-white dark:hover:bg-ocean dark:hover:text-white flex items-center justify-center transition-all duration-200 backdrop-blur-xs border border-white/10 shadow-lg cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-white hover:scale-105"
				aria-label="Previous project"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
			</button>

			<!-- Next Button -->
			<button
				id="lightbox-next"
				type="button"
				class="absolute right-2 sm:right-4 z-10 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-white hover:text-ocean text-white dark:hover:bg-ocean dark:hover:text-white flex items-center justify-center transition-all duration-200 backdrop-blur-xs border border-white/10 shadow-lg cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-white hover:scale-105"
				aria-label="Next project"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="9 18 15 12 9 6"></polyline>
				</svg>
			</button>

			<!-- Image -->
			<img
				id="lightbox-img"
				src=""
				alt=""
				class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-xl opacity-100 will-change-transform"
			/>

			<!-- Fallback when no image -->
			<div id="lightbox-no-img" class="hidden flex-col items-center justify-center text-cool/60 py-12">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mb-2 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
					<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
					<circle cx="8.5" cy="8.5" r="1.5"></circle>
					<polyline points="21 15 16 10 5 21"></polyline>
				</svg>
				<span class="text-sm">No picture available</span>
			</div>
		</div>

		<!-- Footer / Details & Action -->
		<footer class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4 border-t border-white/20 dark:border-slate/60 bg-ocean/80 dark:bg-mirage/30">
			<div class="flex-1 min-w-0 pr-2">
				<p id="lightbox-winner-desc" class="hidden text-xs sm:text-sm text-tulip font-medium line-clamp-2"></p>
				<!-- Mobile Touch Hint -->
				<span class="text-xs text-white/80 dark:text-cool/60 flex sm:hidden items-center gap-1.5 mt-0.5">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 stroke-current shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8m-8 5h8m-8 5h4" />
					</svg>
					<span>Swipe left/right to browse</span>
				</span>
				<!-- Desktop Keyboard Hint -->
				<span class="text-xs text-white/80 dark:text-cool/60 hidden sm:inline-flex items-center gap-2 mt-0.5">
					<span>Use <kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white dark:bg-slate/40 dark:text-iron text-[11px] font-mono">←</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white dark:bg-slate/40 dark:text-iron text-[11px] font-mono">→</kbd> or swipe to navigate</span>
					<span>•</span>
					<span><kbd class="px-1.5 py-0.5 rounded bg-white/20 text-white dark:bg-slate/40 dark:text-iron text-[11px] font-mono">Esc</kbd> to close</span>
				</span>
			</div>

			<div class="flex items-center gap-2 shrink-0">
				<a
					id="lightbox-winner-link"
					href="#"
					target="_blank"
					rel="noopener noreferrer"
					class="hidden items-center gap-1.5 px-3 py-2 rounded-lg bg-tulip text-black hover:bg-tulip/90 dark:bg-tulip/20 dark:hover:bg-tulip/30 dark:border dark:border-tulip/40 dark:text-tulip text-xs sm:text-sm font-semibold transition-colors duration-200 shadow-sm"
				>
					<span>Award Details</span>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>

				<a
					id="lightbox-link"
					href="#"
					target="_blank"
					rel="noopener noreferrer"
					class="hidden inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-lg bg-white hover:bg-mercury text-ocean dark:bg-ocean dark:hover:bg-ocean/85 dark:text-white font-bold text-xs sm:text-sm transition-all duration-200 shadow-md hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
				>
					<span>Visit Project</span>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
			</div>
		</footer>
	</div>
</dialog>

<style>
	#project-lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	#project-lightbox[open] #lightbox-card {
		animation: lightbox-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	:global(.dark) #lightbox-card {
		border-color: rgba(156, 163, 175, 0.5);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18), 0 25px 50px -12px rgba(0, 0, 0, 0.95);
	}
	@keyframes lightbox-pop {
		0% {
			opacity: 0;
			transform: scale(0.96) translateY(6px);
		}
		100% {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}
	.lightbox-slide-left {
		animation: slide-from-right 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	.lightbox-slide-right {
		animation: slide-from-left 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	@keyframes slide-from-right {
		0% {
			opacity: 0.3;
			transform: translateX(36px) scale(0.98);
		}
		100% {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}
	@keyframes slide-from-left {
		0% {
			opacity: 0.3;
			transform: translateX(-36px) scale(0.98);
		}
		100% {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}
</style>

<script>
	function setupProjectLightbox() {
		const dialog = document.getElementById("project-lightbox") as HTMLDialogElement | null;
		if (!dialog) return;

		const stageEl = document.getElementById("lightbox-stage");
		const titleEl = document.getElementById("lightbox-title");
		const imgEl = document.getElementById("lightbox-img") as HTMLImageElement | null;
		const noImgEl = document.getElementById("lightbox-no-img");
		const counterEl = document.getElementById("lightbox-counter");
		const badgeWinnerEl = document.getElementById("lightbox-badge-winner");
		const winnerLabelEl = document.getElementById("lightbox-winner-label");
		const badgePersonalEl = document.getElementById("lightbox-badge-personal");
		const winnerDescEl = document.getElementById("lightbox-winner-desc");
		const winnerLinkEl = document.getElementById("lightbox-winner-link") as HTMLAnchorElement | null;
		const projectLinkEl = document.getElementById("lightbox-link") as HTMLAnchorElement | null;

		const closeBtn = document.getElementById("lightbox-close");
		const prevBtn = document.getElementById("lightbox-prev");
		const nextBtn = document.getElementById("lightbox-next");

		let triggers: HTMLButtonElement[] = [];
		let currentIndex = 0;
		let lastActiveTrigger: HTMLButtonElement | null = null;

		const refreshTriggers = () => {
			triggers = Array.from(document.querySelectorAll<HTMLButtonElement>(".project-lightbox-trigger"));
		};

		const updateContent = (index: number, direction: "next" | "prev" | "none" = "none") => {
			if (!triggers.length) return;
			currentIndex = (index + triggers.length) % triggers.length;
			const targetTrigger = triggers[currentIndex];
			if (!targetTrigger) return;

			const ds = targetTrigger.dataset;
			const title = ds.projectTitle || "";
			const imgUrl = ds.projectImage || "";
			const imgAlt = ds.projectAlt || title;
			const projectUrl = ds.projectUrl || "";
			const isWinner = ds.projectWinner === "true";
			const winnerLabel = ds.projectWinnerLabel || "Award Winner";
			const winnerDesc = ds.projectWinnerDesc || "";
			const winnerUrl = ds.projectWinnerUrl || "";
			const isPersonal = ds.projectPersonal === "true";

			if (titleEl) titleEl.textContent = title;
			if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${triggers.length}`;

			if (imgEl && noImgEl) {
				// Animation on change
				imgEl.classList.remove("lightbox-slide-left", "lightbox-slide-right");
				void imgEl.offsetWidth; // Trigger reflow
				if (direction === "next") {
					imgEl.classList.add("lightbox-slide-left");
				} else if (direction === "prev") {
					imgEl.classList.add("lightbox-slide-right");
				}

				if (imgUrl) {
					imgEl.classList.remove("hidden");
					noImgEl.classList.add("hidden");
					imgEl.src = imgUrl;
					imgEl.alt = imgAlt;
				} else {
					imgEl.classList.add("hidden");
					noImgEl.classList.remove("hidden");
					imgEl.src = "";
					imgEl.alt = "";
				}
			}

			if (badgeWinnerEl && winnerLabelEl) {
				if (isWinner) {
					badgeWinnerEl.classList.remove("hidden");
					badgeWinnerEl.classList.add("inline-flex");
					winnerLabelEl.textContent = winnerLabel;
				} else {
					badgeWinnerEl.classList.add("hidden");
					badgeWinnerEl.classList.remove("inline-flex");
				}
			}

			if (badgePersonalEl) {
				if (isPersonal) {
					badgePersonalEl.classList.remove("hidden");
				} else {
					badgePersonalEl.classList.add("hidden");
				}
			}

			if (winnerDescEl) {
				if (isWinner && winnerDesc) {
					winnerDescEl.textContent = winnerDesc;
					winnerDescEl.classList.remove("hidden");
				} else {
					winnerDescEl.classList.add("hidden");
				}
			}

			if (winnerLinkEl) {
				if (isWinner && winnerUrl) {
					winnerLinkEl.href = winnerUrl;
					winnerLinkEl.classList.remove("hidden");
					winnerLinkEl.classList.add("inline-flex");
				} else {
					winnerLinkEl.classList.add("hidden");
					winnerLinkEl.classList.remove("inline-flex");
				}
			}

			if (projectLinkEl) {
				if (projectUrl) {
					projectLinkEl.href = projectUrl;
					projectLinkEl.classList.remove("hidden");
					projectLinkEl.classList.add("inline-flex");
				} else {
					projectLinkEl.classList.add("hidden");
					projectLinkEl.classList.remove("inline-flex");
				}
			}
		};

		const openLightbox = (index: number, trigger: HTMLButtonElement) => {
			refreshTriggers();
			lastActiveTrigger = trigger;
			updateContent(index, "none");
			dialog.showModal();
			document.body.style.overflow = "hidden";
			closeBtn?.focus();
		};

		const closeLightbox = () => {
			if (!dialog.open) return;
			dialog.close();
			document.body.style.overflow = "";
			lastActiveTrigger?.focus();
		};

		// Event Delegation for triggers
		document.addEventListener("click", (e) => {
			const target = e.target as HTMLElement | null;
			const trigger = target?.closest<HTMLButtonElement>(".project-lightbox-trigger");
			if (!trigger) return;

			e.preventDefault();
			refreshTriggers();
			const idx = triggers.indexOf(trigger);
			if (idx !== -1) {
				openLightbox(idx, trigger);
			}
		});

		// Controls
		closeBtn?.addEventListener("click", closeLightbox);
		prevBtn?.addEventListener("click", () => updateContent(currentIndex - 1, "prev"));
		nextBtn?.addEventListener("click", () => updateContent(currentIndex + 1, "next"));

		// Touch / Swipe Gesture Support
		let touchStartX = 0;
		let touchStartY = 0;
		let touchStartTime = 0;

		const targetSwipeArea = stageEl || dialog;

		targetSwipeArea.addEventListener(
			"touchstart",
			(e: TouchEvent) => {
				if (e.touches.length !== 1) return;
				touchStartX = e.touches[0].clientX;
				touchStartY = e.touches[0].clientY;
				touchStartTime = Date.now();
			},
			{ passive: true }
		);

		targetSwipeArea.addEventListener(
			"touchend",
			(e: TouchEvent) => {
				if (e.changedTouches.length !== 1) return;
				const touchEndX = e.changedTouches[0].clientX;
				const touchEndY = e.changedTouches[0].clientY;
				const deltaX = touchEndX - touchStartX;
				const deltaY = touchEndY - touchStartY;
				const elapsedTime = Date.now() - touchStartTime;

				const absX = Math.abs(deltaX);
				const absY = Math.abs(deltaY);

				// Swipe down to dismiss
				if (deltaY > 100 && absY > absX * 1.5 && elapsedTime < 450) {
					closeLightbox();
					return;
				}

				// Horizontal swipe between projects (min 40px, fast enough or distinct horizontal gesture)
				if (absX > 40 && absX > absY * 1.2 && elapsedTime < 600) {
					if (deltaX < 0) {
						// Swiped Left -> Go Next
						updateContent(currentIndex + 1, "next");
					} else {
						// Swiped Right -> Go Previous
						updateContent(currentIndex - 1, "prev");
					}
				}
			},
			{ passive: true }
		);

		// Backdrop click to close
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) {
				closeLightbox();
			}
		});

		// Keyboard controls
		dialog.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft") {
				e.preventDefault();
				updateContent(currentIndex - 1, "prev");
			} else if (e.key === "ArrowRight") {
				e.preventDefault();
				updateContent(currentIndex + 1, "next");
			} else if (e.key === "Escape") {
				e.preventDefault();
				closeLightbox();
			}
		});

		dialog.addEventListener("cancel", (e) => {
			e.preventDefault();
			closeLightbox();
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupProjectLightbox);
	} else {
		setupProjectLightbox();
	}
</script>
