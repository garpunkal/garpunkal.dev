---
import { Skill } from "../scripts/models/skill";
import SkillItem from "./SkillItem.astro";
import Heading from "./Heading.astro";

interface Props {
	skills: Skill[] | any | null;
	title: string | any | null;
}

const { skills, title } = Astro.props;

// shuffle so the cloud layout isn't always in the same order
function shuffle(items: Skill[]) {
	const shuffled = [...items];
	for (let i = shuffled.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
	}
	return shuffled;
}

const shuffledSkills = shuffle(skills);
---

<section class="text-pale bg-mirage dark:text-iron0 body-font" id="skills">
	<div class="container">
		<Heading title={title} />
		<div class="flex flex-wrap justify-center -m-1 md:-m-2 mb-2 md:mb-2">
			{
				shuffledSkills.map((skill: Skill) => (
					<SkillItem skill={skill} />
				))
			}
		</div>
	</div>
</section>
