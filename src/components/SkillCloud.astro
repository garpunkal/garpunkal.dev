---
import { Skill } from "../scripts/models/skill";
import SkillItem from "./SkillItem.astro";
import Heading from "./Heading.astro";

interface Props {
  skills: Skill[] | any | null;
  title: string | any | null;
}

const { skills, title } = Astro.props;

interface GroupBucket {
  title: string;
  sortOrder: number;
  skills: Skill[];
}

const groupMap = new Map<string, GroupBucket>();
const ungrouped: Skill[] = [];

for (const skill of skills as Skill[]) {
  const gTitle = skill.groupTitle || (skill.group?.[0] ?? "");
  const gOrder = skill.groupOrder ?? 999;

  if (!gTitle) {
    ungrouped.push(skill);
  } else {
    if (!groupMap.has(gTitle)) {
      groupMap.set(gTitle, { title: gTitle, sortOrder: gOrder, skills: [] });
    }
    groupMap.get(gTitle)!.skills.push(skill);
  }
}

// Dynamically sort active groups by Squidex skillgroup sortOrder
const activeGroups = [...groupMap.values()]
  .filter((g) => g.skills.length > 0)
  .sort((a, b) => a.sortOrder - b.sortOrder)
  .map((g) => [g.title, g.skills] as [string, Skill[]]);

if (ungrouped.length > 0) {
  activeGroups.push(["Other", ungrouped]);
}

// If nothing is grouped at all, fall back to flat list
const isGrouped = activeGroups.some(([key]) => key !== "Other") || false;
---

<section class="text-iron bg-transparent dark:text-iron body-font" id="skills">
  <div class="container">
    <Heading title={title} />
    {
      isGrouped ? (
        <div class="space-y-8">
          {activeGroups.map(([group, groupSkills]) => (
            <div class="pb-6 border-b border-slate/30 last:border-b-0 last:pb-0">
              <h3 class="skill-group-label text-sm font-semibold uppercase tracking-widest text-iron dark:text-mercury mb-3 text-left">
                {group}
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2.5 md:gap-3">
                {groupSkills.map((skill: Skill) => (
                  <SkillItem skill={skill} />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div
          id="skillCloud"
          class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2.5 md:gap-3 mb-2 md:mb-2"
        >
          {skills.map((skill: Skill) => (
            <SkillItem skill={skill} />
          ))}
        </div>
      )
    }
  </div>
</section>
