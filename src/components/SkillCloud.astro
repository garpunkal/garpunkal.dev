---
import { Skill } from "../scripts/models/skill";
import SkillItem from "./SkillItem.astro";
import Heading from "./Heading.astro";

interface Props {
	skills: Skill[] | any | null;
	title: string | any | null;
}

const { skills, title } = Astro.props;
---

<section class="text-pale bg-mirage dark:text-iron0 body-font" id="skills">
	<div class="container">
		<Heading title={title} />
		<div id="skillCloud" class="flex flex-wrap justify-center -m-1 md:-m-2 mb-2 md:mb-2">
			{
				skills.map((skill: Skill) => (
					<SkillItem skill={skill} />
				))
			}
		</div>
	</div>
</section>
