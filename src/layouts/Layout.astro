---
import "../styles/app.css";

import Profile from "../components/Profile.astro";
import Footer from "../components/Footer.astro";
import { getHome } from "../scripts/squidex.ts";
import { GoogleFontsOptimizer } from "@garpunkal/astro-google-fonts-optimizer";

const home = await getHome();

interface Props {
	title: string;
	header: boolean;
}

const { title, header } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://garpunkal.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const sameAsLinks = [
	home?.githubUrl,
	...(home?.socials?.map((s: any) => s.url) ?? []),
].filter((url): url is string => typeof url === "string" && url.startsWith("http"));

const sameAs = Array.from(new Set(sameAsLinks));

const specialismTitles = home?.specialisms?.map((s: any) => s.title).filter(Boolean) ?? [];
const defaultKnowsAbout = [
	".NET",
	"C#",
	"Solutions Architecture",
	"Umbraco",
	"TypeScript",
	"Astro",
	"Front End Development",
	"Azure DevOps",
	"Cloud Architecture",
];
const knowsAbout = Array.from(new Set([...specialismTitles, ...defaultKnowsAbout]));

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteUrl}/#person`,
			name: home?.title || "Gareth Wright",
			alternateName: ["garpunkal", "@garpunkal"],
			url: siteUrl,
			image: "https://en.gravatar.com/userimage/11972664/1f60f14a9a99398eefe01621f2c73860.png?size=400",
			jobTitle: "Senior .NET & C# Solutions Architect",
			description: "Senior .NET & C# Solutions Architect, Umbraco Certified Expert, and Front End Developer.",
			sameAs,
			knowsAbout,
		},
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: siteUrl,
			name: "garpunkal.dev",
			description: "Senior .NET & C# Solutions Architect & Umbraco Certified Expert.",
			publisher: {
				"@id": `${siteUrl}/#person`,
			},
			inLanguage: "en-GB",
		},
		{
			"@type": "ProfilePage",
			"@id": `${canonicalUrl}#webpage`,
			url: canonicalUrl,
			name: title,
			isPartOf: {
				"@id": `${siteUrl}/#website`,
			},
			about: {
				"@id": `${siteUrl}/#person`,
			},
			mainEntity: {
				"@id": `${siteUrl}/#person`,
			},
			inLanguage: "en-GB",
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>

		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="format-detection" content="telephone=no" />
		<meta
			name="keywords"
			content="garpunkal, gareth wright, garpunkal.dev, backend developer, umbraco, umbraco certified developer, c# developer, senior, dotnet, dotnet core, developer, umbraco certified expert, andover, hampshire, csharp, tailwind, front end, astro, typescript"
		/>
		<meta
			name="description"
			content="Gareth Wright - Senior .NET & C# Solutions Architect - Umbraco Certified Expert - Front End Developer"
		/>
		<meta name="author" content="Gareth Wright" />
		<meta name="copyright" content="Gareth Wright" />
		<meta name="theme-color" content="#077DA0" />

		<meta property="og:title" content="Gareth Wright - garpunkal.dev" />
		<meta property="og:site_name" content="garpunkal.dev" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://garpunkal.dev" />
		<meta
			property="og:image"
			content="https://en.gravatar.com/userimage/11972664/1f60f14a9a99398eefe01621f2c73860.png?size=400"
		/>
		<meta property="og:description" content="Senior .NET & C# Solutions Architect & Umbraco Certified Expert." />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="https://garpunkal.dev" />
		<meta name="twitter:title" content="Gareth Wright - garpunkal.dev" />
		<meta name="twitter:description" content="Senior .NET & C# Solutions Architect & Umbraco Certified Expert." />
		<meta name="twitter:creator" content="@garpunkal" />
		<meta
			name="twitter:image:src"
			content="https://en.gravatar.com/userimage/11972664/1f60f14a9a99398eefe01621f2c73860.png?size=400"
		/>

		<link rel="publisher" href="https://garpunkal.dev" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#077DA0" />
		<link rel="manifest" href="/manifest.webmanifest" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<GoogleFontsOptimizer url="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;800&display=swap" />
		<script src="../scripts/client/entry.js"></script>
	</head>
	<body class="bg-ocean dark:bg-black">
		<a href="#main" class="absolute left-[-9999px] z-999 bg-black p-1 text-white opacity-0 focus:left-1/2 focus:-translate-x-1/2 focus:opacity-100">Skip to main content</a>
		<header>
			{header ? <Profile home={home} /> : ""}
		</header>
		<main id="main">
			<slot />
		</main>
		<footer> 
			<Footer home={home} />
		</footer>
	</body>
</html>
