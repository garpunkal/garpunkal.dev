---
import Layout from "../layouts/Layout.astro";
import Projects from "../components/Projects.astro";
import Experiences from "../components/Experiences.astro";
import Articles from "../components/Articles.astro";
import SkillCloud from "../components/SkillCloud.astro";

import { getExperiences, getProjects, getHome, getSkills } from "../scripts/squidex.ts";
import { getArticles } from "../scripts/devto.ts";

const experiences = await getExperiences();
const projects = await getProjects();
const home = await getHome();
const skills = await getSkills();
const articles = await getArticles();
---

<Layout title="Gareth Wright - garpunkal.dev" header={true}>
	<Projects projects={projects.filter((x) => !x.personal)} title={home?.projectsLabel} />
	<Experiences home={home} experiences={experiences} />
	<SkillCloud skills={skills} title={home?.skillsLabel ?? "Skills"} />
	<Projects projects={projects.filter((x) => x.personal)} title={home?.personalProjectsLabel} />
	<Articles home={home} articles={articles} />
</Layout>
