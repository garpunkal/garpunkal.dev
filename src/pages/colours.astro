---
import Layout from "../layouts/Layout.astro";

const colours = [
  { name: "white",    hex: "#ffffff" },
  { name: "black",    hex: "#000000" },
  { name: "ocean",    hex: "#077da0" },
  { name: "mirage",   hex: "#111827" },
  { name: "tulip",    hex: "#e3b440" },
  { name: "slate",    hex: "#475569" },
  { name: "iron",     hex: "#d1d5db" },
  { name: "cool",     hex: "#9ca3af" },
  { name: "mercury",  hex: "#e5e7eb" },
  { name: "pale",     hex: "#a1a1a1" },
  { name: "vampire",  hex: "#4b5563" },
  { name: "elephant", hex: "#1f3245" },
];
---

<Layout title="Colours - garpunkal.dev" header={false}>
  <section class="min-h-screen py-16 px-6">
    <div class="max-w-5xl mx-auto">

      <h1 class="text-center text-white dark:text-mercury text-5xl font-extrabold tracking-tighter mb-2">
        Colour Palette
      </h1>
      <p class="text-center text-cool text-xs font-semibold tracking-widest uppercase mb-14">
        Custom theme colours &mdash; garpunkal.dev
      </p>

      <div class="flex flex-wrap -m-3">
        {colours.map((colour) => (
          <div class="w-1/2 md:w-1/3 lg:w-1/4 p-3">
            <div class="color-card flex flex-col shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 ease-out border-2 border-white cursor-pointer relative group" data-hex={colour.hex} title="Click to copy Hex">
              <div class="h-40" style={`background-color: ${colour.hex};`}></div>
              <div class="bg-white px-4 pt-3 pb-4 relative">
                <p class="text-mirage font-black text-base leading-tight mb-2">{colour.name}</p>
                <div style="border-top: 1px solid #e5e7eb;" class="pt-2">
                  <p class="text-[9px] text-cool font-semibold tracking-widest uppercase mb-0.5">Hex</p>
                  <p class="text-mirage font-bold text-xs tracking-wide">{colour.hex}</p>
                  <p class="text-pale font-mono text-[9px] mt-1.5">bg-{colour.name}</p>
                </div>
                
                <div class="copied-badge absolute top-3 right-3 opacity-0 transition-opacity duration-300 bg-ocean text-white text-[9px] font-bold uppercase tracking-widest py-1 px-2 rounded pointer-events-none">
                  Copied!
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-14">
        <a href="/" class="inline-flex items-center gap-2 text-cool hover:text-ocean text-xs font-semibold tracking-widest uppercase transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </a>
      </div>

    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.color-card').forEach(card => {
      card.addEventListener('click', async () => {
        const hex = card.getAttribute('data-hex');
        if (hex) {
          try {
            await navigator.clipboard.writeText(hex);
            const badge = card.querySelector('.copied-badge');
            if (badge) {
              badge.classList.remove('opacity-0');
              badge.classList.add('opacity-100');
              setTimeout(() => {
                badge.classList.remove('opacity-100');
                badge.classList.add('opacity-0');
              }, 1500);
            }
          } catch (err) {
            console.error('Failed to copy text: ', err);
          }
        }
      });
    });
  });
</script>
